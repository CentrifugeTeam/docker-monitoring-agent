<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.docker-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/docker_agent/venv/bin/python</string>
        <string>-m</string>
        <string>src.agent</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/opt/docker_agent</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/opt/docker_agent/agent.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/docker_agent/agent.log</string>
</dict>
</plist>
